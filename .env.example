# Settings read by `docker compose` (copy this file to .env, or let
# `python3 discover.py --save` create .env with the TV it finds).

# The Roku's address: `python3 discover.py` on the host, or on the TV under
# Settings > Network > About.
TV_IP=

# Host port to publish; 80 gives a bare http://tv.lan
PORT=8000
